# Wake-word training worker (Desktop Jarvis Overhaul B3)
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir httpx==0.27.2 pyyaml==6.0.2 \
    && apt-get update \
    && apt-get install -y --no-install-recommends openssh-client rsync \
    && rm -rf /var/lib/apt/lists/*

# openwakeword is only required when WAKE_TRAIN_COMMAND actually invokes
# train_wake_word.py's "python -m openwakeword.train" path — installed here
# so the image is ready for that once the real training recipe is wired up.
RUN pip install --no-cache-dir openwakeword>=0.6.0 || true

COPY wake_word_training_worker.py train_wake_word.py /app/

CMD ["python", "wake_word_training_worker.py"]
