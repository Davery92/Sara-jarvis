# pyannote diarization scaffold service
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

ARG INSTALL_PYANNOTE=false

RUN pip install --no-cache-dir \
    fastapi==0.115.2 \
    uvicorn[standard]==0.30.6 \
    pydantic==2.9.2 \
    && if [ "$INSTALL_PYANNOTE" = "true" ]; then \
      pip install --no-cache-dir pyannote.audio==3.3.2; \
    fi

COPY pyannote_service.py /app/

CMD ["python", "pyannote_service.py"]
