# ASR Service using faster-whisper
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    fastapi==0.115.2 \
    uvicorn[standard]==0.30.6 \
    pydantic==2.9.2 \
    httpx==0.27.2 \
    requests==2.32.3 \
    python-multipart==0.0.12 \
    faster-whisper==1.1.0

# faster-whisper 1.1.0 ships CTranslate2 4.x, which needs CUDA 12 cuBLAS + cuDNN 9
# at *inference* time. The `nvidia` container runtime injects only the GPU driver
# (libcuda), NOT these math libs — so on a slim base, model load succeeds but every
# transcription 500s with "libcublas.so.12 is not found". Ship the libs as pip wheels
# and put them on the loader path. (Without this, GPU transcription is broken.)
RUN pip install --no-cache-dir \
    nvidia-cublas-cu12==12.* \
    nvidia-cudnn-cu12==9.*
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.11/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.11/site-packages/nvidia/cudnn/lib

COPY asr_service.py /app/

CMD ["python", "asr_service.py"]
