# Control-plane target
SARA_BACKEND_URL=http://10.185.1.180:8000

# Internal service auth
VOICE_INTERNAL_SERVICE=wake-sensor
VOICE_CONTROL_INTERNAL_TOKEN=change-me-voice-internal-token

# Runtime
WAKE_SENSOR_SIMULATE=true
WAKE_SENSOR_LOG_LEVEL=INFO

# Wake and VAD defaults
WAKE_SENSOR_KEYWORD=hey sara
WAKE_SENSOR_WAKE_THRESHOLD=0.58
WAKE_SENSOR_VAD_THRESHOLD=0.50
WAKE_SENSOR_SILENCE_MS=650

# Loop timing
WAKE_SENSOR_HEARTBEAT_INTERVAL_SECONDS=15
WAKE_SENSOR_SIMULATION_INTERVAL_SECONDS=20
WAKE_SENSOR_AMBIENT_SAMPLE_INTERVAL_SECONDS=120
WAKE_SENSOR_CONFIG_SYNC_INTERVAL_SECONDS=30

# Training job worker
WAKE_SENSOR_TRAINING_ENABLED=true
WAKE_SENSOR_TRAINING_POLL_INTERVAL_SECONDS=6
WAKE_SENSOR_AUTO_ACTIVATE_TRAINED_MODEL=false
