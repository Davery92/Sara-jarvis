FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Don't copy source code - it will be mounted as a volume
# This way code changes trigger hot-reload

# Expose port
EXPOSE 3002

# Start development server with hot-reload
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3002"]
