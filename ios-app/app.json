{
  "expo": {
    "name": "Sara",
    "slug": "sara-ios-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#18181b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avery.sara",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "NSMicrophoneUsageDescription": "Sara needs access to your microphone for voice chat.",
        "NSSpeechRecognitionUsageDescription": "Sara needs access to speech recognition for voice chat."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#18181b"
      },
      "package": "com.avery.sara"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "sara"
  }
}
