# syntax=docker/dockerfile:1.4
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Use BuildKit cache to avoid re-downloading wheels on rebuilds
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt --ignore-installed \
    && pip install email-validator aiofiles lxml_html_clean

# Install Playwright's Chromium + system libraries for browser-based source
# fetching (JS-rendered / bot-blocked pages the httpx fetch can't read).
# --with-deps runs apt at build time (root) so there is no runtime sudo blocker.
# Browsers live in a world-readable path so any runtime user can launch them.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN playwright install --with-deps chromium

# Create a stable non-root runtime user for dev containers that need access to
# host-mounted files under /home/david (SSH keys, generated artifacts, etc.).
RUN groupadd -g 1000 david \
    && useradd -m -u 1000 -g 1000 -d /home/david david \
    && mkdir -p /home/david/.ssh /home/david/jarvis/data \
    && chown -R 1000:1000 /home/david

# Don't copy code - it will be mounted as a volume
# This way code changes are instant

# Expose port
EXPOSE 8000

# Run without auto-reload — restart container to pick up changes
# (--reload causes hangs during shutdown when background tasks are active)
CMD ["uvicorn", "app.main_simple:app", "--host", "0.0.0.0", "--port", "8000"]
