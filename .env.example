# =============================================================================
# Sara Hub - Environment Configuration Template
# =============================================================================
# Copy this to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# Security
JWT_SECRET=change-me-to-a-random-secret

# Database
DATABASE_URL=postgresql+psycopg://sara:YOUR_PASSWORD@localhost:5432/sara_hub
POSTGRES_PASSWORD=YOUR_PASSWORD

# Storage (MinIO)
MINIO_SECRET_KEY=YOUR_MINIO_SECRET
MINIO_ROOT_PASSWORD=YOUR_MINIO_SECRET

# Home Assistant
HA_TOKEN=YOUR_HA_LONG_LIVED_TOKEN

# Microsoft Graph Email Integration
MSGRAPH_CLIENT_ID=YOUR_CLIENT_ID
MSGRAPH_CLIENT_SECRET=YOUR_CLIENT_SECRET
MSGRAPH_TENANT_ID=YOUR_TENANT_ID

# API Keys
GEMINI_API_KEY=YOUR_GEMINI_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
OPENAI_API_KEY=dummy
TAVILY_API_KEY=YOUR_TAVILY_KEY

# Neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD

# Domain configuration
DOMAIN=sara.avery.cloud
COOKIE_DOMAIN=.sara.avery.cloud

# Food APIs
USDA_API_KEY=YOUR_USDA_KEY
FATSECRET_CLIENT_ID=YOUR_FATSECRET_ID
FATSECRET_CLIENT_SECRET=YOUR_FATSECRET_SECRET

# Sentry Error Tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# GitHub Integration (optional)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
