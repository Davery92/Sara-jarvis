# =============================================================================
# Sara Hub - Environment Configuration Template
# =============================================================================
# Copy this to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# Security
JWT_SECRET=change-me-to-a-random-secret
# Comma-separated emails allowed to access /api/automation/admin endpoints
AUTOMATION_ADMIN_EMAILS=

# Database
DATABASE_URL=postgresql+psycopg://sara:YOUR_PASSWORD@localhost:5432/sara_hub
POSTGRES_PASSWORD=YOUR_PASSWORD

# Storage (MinIO)
MINIO_SECRET_KEY=YOUR_MINIO_SECRET
MINIO_ROOT_PASSWORD=YOUR_MINIO_SECRET

# Home Assistant
HA_TOKEN=YOUR_HA_LONG_LIVED_TOKEN

# Microsoft Graph Email Integration
MSGRAPH_CLIENT_ID=YOUR_CLIENT_ID
MSGRAPH_CLIENT_SECRET=YOUR_CLIENT_SECRET
MSGRAPH_TENANT_ID=YOUR_TENANT_ID

# API Keys
GEMINI_API_KEY=YOUR_GEMINI_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
OPENAI_API_KEY=dummy
TAVILY_API_KEY=YOUR_TAVILY_KEY

# ChatGPT Codex OAuth (optional)
# Defaults align with Codex OAuth; override only if you have your own OpenAI OAuth app.
CODEX_OAUTH_CLIENT_ID=
CODEX_OAUTH_REDIRECT_URI=
CODEX_OAUTH_ORIGINATOR=codex_vscode

# Background LLM (autonomy, reflection, journaling)
BG_LLM_PRIMARY_URL=http://100.104.68.115:11434/v1
BG_LLM_PRIMARY_MODEL=gpt-oss:20b
BG_LLM_FALLBACK_URL=http://10.185.1.8:11434/v1
BG_LLM_FALLBACK_MODEL=gpt-oss:20b
BG_LLM_REQUEST_TIMEOUT=90
BG_LLM_CONNECT_TIMEOUT=6
BG_LLM_NUM_CTX=16384

# Neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD

# Domain configuration
DOMAIN=sara.avery.cloud
COOKIE_DOMAIN=.sara.avery.cloud
# Optional explicit URL for the workbench canvas app (used by web UI "Canvas" navigation)
VITE_WORKBENCH_URL=

# Food APIs
USDA_API_KEY=YOUR_USDA_KEY
FATSECRET_CLIENT_ID=YOUR_FATSECRET_ID
FATSECRET_CLIENT_SECRET=YOUR_FATSECRET_SECRET

# Sentry Error Tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# GitHub Integration (optional)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Autonomy Evolution Feature Flags
AUTONOMY_TRACES_ENABLED=true
AUTONOMY_STRUCTURED_PLAN=false
AUTONOMY_POLICY_ENGINE=false
AUTONOMY_ATTENTION_ENABLED=false
AUTONOMY_MISSIONS_ENABLED=false
AUTONOMY_POLICY_CANDIDATES_ENABLED=false
TEMERANT_ENABLED=true
TEMERANT_ORACLE_ENABLED=true
TEMERANT_NARRATIVE_ENABLED=true
TEMERANT_AUTO_INGESTION_ENABLED=false
TEMERANT_RPG_ENABLED=true
TEMERANT_RPG_NARRATIVE_ENABLED=true
TEMERANT_RPG_MODEL=gpt-oss:120b-32k
TEMERANT_RPG_NUM_CTX=32768

# Rollout threshold defaults for autonomy health evaluation
AUTONOMY_ROLLOUT_MIN_RUNS_FOR_EVAL=10
AUTONOMY_ROLLOUT_MAX_FALLBACK_RATE=0.25
AUTONOMY_ROLLOUT_MAX_ACTION_FAILURE_RATE=0.10
AUTONOMY_ROLLOUT_MAX_DEDUP_BLOCK_RATE=0.45
AUTONOMY_ROLLOUT_MAX_ATTENTION_BACKLOG_RATIO=0.70
AUTONOMY_ROLLOUT_MAX_MISSION_FAILURE_RATE=0.20
AUTONOMY_ROLLOUT_MAX_MISSION_NONTERMINAL_RATIO=0.70
